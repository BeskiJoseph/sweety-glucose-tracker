# Sweety Blood Glucose Tracker — Docker Compose Environment Configuration

# Service Ports on Host
CLIENT_PORT=3000
API_PORT=5001
POSTGRES_PORT=5434
REDIS_PORT=6380

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=sweety_db

# Security
JWT_SECRET=sweety_docker_super_secret_jwt_key_32chars_long
JWT_EXPIRES_IN=7d

# Caching & Scheduling
REPORT_CACHE_TTL_SECONDS=300
REMINDER_SCHEDULE_CRON=0 20 * * *
REMINDER_TIMEZONE=UTC
