# Environment mode: development | production | test
NODE_ENV=development

# API Server Port
PORT=5000

# Client Application URL (CORS origin)
CLIENT_URL=http://localhost:5173

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres:root@localhost:5432/sweety_db

# Explicit PostgreSQL SSL setting (true | false). Defaults to false in dev, true in prod.
DATABASE_SSL=false

# Optional custom CA certificate path for cloud PostgreSQL databases
# DATABASE_SSL_CA=/path/to/ca-certificate.crt

# JSON Web Token Secret (minimum 16 chars in dev, 32 chars in production)
JWT_SECRET=sweety_super_secret_jwt_key_dev_mode_12345

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# Redis connection URL for Report Caching and BullMQ Worker
REDIS_URL=redis://127.0.0.1:6379

# Redis report cache TTL in seconds (default: 300 = 5 minutes)
REPORT_CACHE_TTL_SECONDS=300

# BullMQ Daily Reminder Cron Schedule (standard 5-part cron syntax)
REMINDER_SCHEDULE_CRON=0 20 * * *

# Timezone for reminder schedule and date evaluations (e.g. UTC, America/New_York)
REMINDER_TIMEZONE=UTC
